class File {
    //int id;
    String name;
    int size;
    File(String name, int size){
        //this.id = id;
        this.name = name;
        this.size = size;
    }
}

class Tag {
    String tagName;
    List<File> files;
    int size;
    Tag(String tagName, List<File> files){
        this.tagName = tagName;
        this.files = new ArrayList<>();
    }

    public int getSize(){
        //int curTagSize = 0;
        if(files == null || files.isEmpty()) return 0;

        for(File file: files){
            this.size += file.size;
        }

        return this.size;
    }
}
// Max Heap
class TagComparator implements Comparator<Tag>{
    public int compare(Tag t1, Tag t2){
        if(t1.size > t2.size){
            return -1;
        }else if(t1.size < t2.size){
            return 1;
        }else{
            return 0;
        }
    }
}

